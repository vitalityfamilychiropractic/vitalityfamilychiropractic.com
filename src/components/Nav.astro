---
import Icon from './Icon.astro';
import { isAncestor, isCurrent, type NavItem } from '../lib/nav';

interface Item extends NavItem {
  subId?: string;
}

interface Props {
  items: Item[];
  pathname: string;
  /** Desktop menu or the mobile drawer. */
  variant: 'desktop' | 'mobile';
  label: string;
}

const { items, pathname, variant, label } = Astro.props;
const mobile = variant === 'mobile';
// `devOnly` grays a link on the dev server. On a parent it also grays the
// parent's toggle and every child; a child can also set it for itself.
---

<nav class={mobile ? undefined : 'primary'} aria-label={label}>
  <ul class:list={['nav', mobile && 'nav-m']} data-nav={mobile ? undefined : true}>
    {
      items.map((item) => {
        const here = isAncestor(item, pathname);
        const current = isCurrent(item.href, pathname);
        return (
          <li class:list={[item.children && 'has-sub', here && 'in-section']}>
            {item.heading && item.children && (
              <button
                class:list={['nav-link', 'nav-heading', 'sub-toggle', item.devOnly && 'is-off']}
                type="button" aria-expanded="false" aria-controls={item.subId}>
                {item.label}
                <Icon name="chevron" class="i chev" />
              </button>
            )}
            {!item.heading && item.children && item.href && (
              <div class="nav-pair">
                <a
                  class:list={['nav-link', item.devOnly && 'is-off']}
                  href={item.href}
                  aria-current={current ? 'page' : undefined}
                >
                  {item.label}
                </a>
                <button class:list={['sub-toggle', item.devOnly && 'is-off']} type="button" aria-expanded="false" aria-controls={item.subId}>
                  <span class="sr">{item.label} menu</span>
                  <Icon name="chevron" class="i chev" />
                </button>
              </div>
            )}
            {!item.children && item.href && (
              <a
                class:list={['nav-link', item.devOnly && 'is-off']}
                href={item.href}
                aria-current={current ? 'page' : undefined}
              >
                {item.label}
              </a>
            )}
            {!item.children && !item.href && <span class="nav-link is-static">{item.label}</span>}
            {item.children && (
              <ul class="sub" id={item.subId}>
                {item.children.map((child) => (
                  <li>
                    <a
                      class:list={[(item.devOnly || child.devOnly) && 'is-off']}
                      href={child.href}
                      aria-current={isCurrent(child.href, pathname) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
