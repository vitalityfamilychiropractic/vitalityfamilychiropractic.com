---
import { displayName } from '../config/team';
import type { Location, TeamMember } from '../config/types';

interface Props {
  location: Location;
  member: TeamMember;
}

const { location, member } = Astro.props;
const name = displayName(member);
---

<div class="card" style="width: 18rem;">
  {
    member.photo && (
      <img class="card-img-top card-img-bottom my-2" alt={name} src={member.photo} />
    )
  }
  <div class="card-body">
    <h5 class="card-title">{name}</h5>
    <a class="btn btn-primary" href={`/${location.slug}/team/${member.slug}/`}>Read More</a>
  </div>
</div>
