---
import type { Location } from '../config/types';

interface Props {
  location: Location;
}

const { location } = Astro.props;
---

<div class="container">
  <h2 id="appt-request-heading">Appointment Request Form</h2>
  <form
    id="appt-request-form"
    action={location.form.endpoint}
    method="POST"
    aria-labelledby="appt-request-heading"
  >
    <input type="hidden" name="location" value={location.slug} />
    <div class="row">
      <div class="form-group col-md-12">
        <label for="name">Name:</label>
        <input id="name" class="form-control" type="text" name="name" autocomplete="name" required />
      </div>
    </div>
    <div class="row">
      <div class="form-group col-md-6">
        <label for="email">Email:</label>
        <input id="email" class="form-control" type="email" name="email" autocomplete="email" required />
      </div>
      <div class="form-group col-md-6">
        <label for="phone">Phone Number:</label>
        <input id="phone" class="form-control" type="tel" name="phone" autocomplete="tel" required />
      </div>
    </div>
    <div class="row">
      <div class="form-group col-md-12">
        <label for="contactMethod">Preferred Contact Method:</label>
        <select id="contactMethod" class="form-control" name="preferred contact method" required>
          <option value="" selected disabled>Choose...</option>
          <option>Email</option>
          <option>Phone</option>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="form-group col-md-12">
        <label for="comments">Comments:</label>
        <textarea id="comments" class="form-control" name="comments"></textarea>
      </div>
    </div>
    <div class="row">
      <div class="form-group col-md-12 my-2">
        <button id="appt-request-form-button" class="btn btn-primary" type="submit">Submit</button>
      </div>
    </div>
    <p id="appt-request-form-status" role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  const form = document.getElementById('appt-request-form');
  if (form instanceof HTMLFormElement) {
    const status = document.getElementById('appt-request-form-status');

    function showStatus(kind: 'success' | 'danger', message: string) {
      if (!status) return;
      status.replaceChildren();
      const alert = document.createElement('div');
      alert.className = kind === 'success' ? 'alert alert-success' : 'alert alert-danger';
      alert.textContent = message;
      status.append(alert);
      status.tabIndex = -1;
      status.focus();
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const button = document.getElementById('appt-request-form-button');
      if (button instanceof HTMLButtonElement) button.disabled = true;
      const data = new FormData(form);
      fetch(form.action, {
        method: form.method,
        body: data,
        headers: { Accept: 'application/json' },
      })
        .then((response) => {
          if (response.ok) {
            showStatus('success', 'We have received your request and will be in contact soon.');
            form.reset();
            return;
          }
          return response.json().then((body: { errors?: Array<{ message: string }> }) => {
            const message = body.errors?.map((error) => error.message).join(', ');
            showStatus('danger', message || 'Oops! There was a problem submitting your form.');
          });
        })
        .catch(() => {
          showStatus('danger', 'Oops! There was a problem submitting your form.');
        })
        .finally(() => {
          if (button instanceof HTMLButtonElement) button.disabled = false;
        });
    });
  }
</script>
