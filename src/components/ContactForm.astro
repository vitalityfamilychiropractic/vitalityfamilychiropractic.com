---
import { site } from '../config/site';
import type { Location } from '../config/types';

interface Props {
  location: Location;
}

const { location } = Astro.props;

// Each office posts to the mailer named in locations.ts. The access key is
// what tells us that office is ready to receive mail.
const { endpoint, accessKey } = location.form;
const configured = !accessKey.startsWith('REPLACE_WITH');
const subject = `Message — ${location.name} (${site.name})`;
---

<div class="fm">
  {
    !configured && (
      <p class="fm-warning" role="note">
        <strong>Setup needed:</strong> this office has no form access key yet, so
        submissions will not be delivered. Add one to <code>src/config/locations.ts</code>.
        Until then, please email <a href={`mailto:${location.email}`}>{location.email}</a>.
      </p>
    )
  }

  <h2 class="fm-title" id="contact-form-title">Send a message</h2>
  <p class="fm-lead">
    New patients can use this form to request an appointment. You can also use it
    for any other message for our {location.name} office.
  </p>
  <p class="fm-disclaimer" id="phi-note" role="note">
    Please do not include protected health information in your message.
  </p>

  {/*
    A plain POST form. With scripting off it submits natively to the form
    service and the browser's own validation applies. The script below takes
    over to give inline messages and keep the visitor on the page.
  */}
  <form
    class="fm-form"
    id="contact-form"
    method="POST"
    action={endpoint}
    data-fallback-email={location.email}
    aria-labelledby="contact-form-title"
  >
    <input type="hidden" name="subject" value={subject} />
    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="from_name" value={`${site.name} website`} />
    <input type="hidden" name="location" value={location.name} />

    {/*
      Honeypot. A person never sees these fields. `botcheck` is the draft
      field; `_gotcha` is the one Formspree treats as spam.
    */}
    <div class="fm-honeypot" aria-hidden="true">
      <label for="botcheck">Leave this field empty</label>
      <input id="botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
      <label for="gotcha">Leave this field empty</label>
      <input id="gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <div class="fm-grid">
      <p class="fm-field">
        <label class="fm-label" for="name">
          Name <span class="fm-req" aria-hidden="true">*</span>
        </label>
        <input
          class="fm-input"
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-describedby="name-error"
          data-error-label="Your name"
        />
        <span class="fm-error" id="name-error" data-error-for="name"></span>
      </p>

      <p class="fm-field">
        <label class="fm-label" for="email">
          Email <span class="fm-req" aria-hidden="true">*</span>
        </label>
        <input
          class="fm-input"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-describedby="email-error"
          data-error-label="Your email address"
        />
        <span class="fm-error" id="email-error" data-error-for="email"></span>
      </p>

      <p class="fm-field">
        <label class="fm-label" for="phone">Phone number</label>
        <input
          class="fm-input"
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          aria-describedby="phone-hint phone-error"
          data-error-label="Your phone number"
        />
        <span class="fm-hint" id="phone-hint">Needed only if you would like us to call you.</span>
        <span class="fm-error" id="phone-error" data-error-for="phone"></span>
      </p>

      <p class="fm-field">
        <label class="fm-label" for="contactMethod">Preferred contact method</label>
        <select class="fm-input" id="contactMethod" name="contactMethod">
          <option value="Email">Email</option>
          <option value="Phone call">Phone call</option>
        </select>
      </p>

      <p class="fm-field fm-wide">
        <label class="fm-label" for="comments">
          How can we help? <span class="fm-req" aria-hidden="true">*</span>
        </label>
        <textarea
          class="fm-input fm-textarea"
          id="comments"
          name="comments"
          rows="5"
          required
          aria-describedby="comments-hint phi-note comments-error"
          data-error-label="A short message"></textarea>
        <span class="fm-hint" id="comments-hint">
          Tell us what is going on and when you would like to come in.
        </span>
        <span class="fm-error" id="comments-error" data-error-for="comments"></span>
      </p>
    </div>

    <p class="fm-required">
      Fields marked <span aria-hidden="true">*</span>
      <span class="sr">with an asterisk</span> are required.
    </p>

    <button class="btn fm-submit" id="appt-request-form-button" type="submit">
      Send request
    </button>

    <div class="fm-status" id="form-status" role="status" aria-live="polite"></div>
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');

  if (form && status) {
    // Suppress the browser's own bubbles now that we can render inline errors.
    // Set here rather than in the markup so no-JS visitors keep native validation.
    form.noValidate = true;

    const fields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input[required], textarea[required], input[type="email"], input[type="tel"]',
      ),
    );

    function errorNode(field: HTMLElement) {
      return form?.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`) ?? null;
    }

    /** Show or clear the message for one field. Returns true when valid. */
    function validate(field: HTMLInputElement | HTMLTextAreaElement) {
      const node = errorNode(field);
      const valid = field.checkValidity();

      field.setAttribute('aria-invalid', valid ? 'false' : 'true');
      if (node) node.textContent = valid ? '' : messageFor(field);
      return valid;
    }

    function messageFor(field: HTMLInputElement | HTMLTextAreaElement) {
      // `data-error-label` rather than the visible label: "How can we help?"
      // works as a question above the box but not inside a sentence.
      const label = field.dataset.errorLabel ?? 'This field';

      if (field.validity.valueMissing) return `${label} is required.`;
      if (field.validity.typeMismatch && field.type === 'email') {
        return 'Please enter a complete email address, like name@example.com.';
      }
      return field.validationMessage || `Please check ${label.toLowerCase()}.`;
    }

    for (const field of fields) {
      // Only nag after the user has left the field once.
      field.addEventListener('blur', () => validate(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const results = fields.map(validate);
      if (results.includes(false)) {
        status.dataset.state = 'error';
        status.textContent = 'Please fix the highlighted fields and try again.';
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('.fm-submit');
      const originalLabel = submit?.textContent ?? '';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      status.dataset.state = '';
      status.textContent = 'Sending your message…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (!response.ok) throw new Error(`Request failed: ${response.status}`);

        status.dataset.state = 'success';
        status.textContent = 'Thank you. Your message has been sent. We will be in touch shortly.';
        form.reset();
        for (const field of fields) field.setAttribute('aria-invalid', 'false');
      } catch {
        const mailto = form.dataset.fallbackEmail;
        status.dataset.state = 'error';
        status.textContent = mailto
          ? `Sorry, we could not send that. Please email us at ${mailto} or give us a call.`
          : 'Sorry, we could not send that. Please give us a call and we will get you booked in.';
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      }
    });
  }
</script>
