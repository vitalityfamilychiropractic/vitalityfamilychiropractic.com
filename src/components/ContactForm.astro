---
import { TURNSTILE_SITE_KEY } from 'astro:env/server';
import { MIN_SUBMIT_MS } from '../lib/contact';
import type { Location } from '../config/types';

interface Props {
  location: Location;
}

const { location } = Astro.props;
const siteKey = TURNSTILE_SITE_KEY ?? '';
const page = `/${location.slug}/contact/`;
---

<div class="fm">
  <h2 class="fm-title" id="contact-form-title">Send a message</h2>
  <p class="fm-lead">
    New patients can use this form to request an appointment. You can also use it
    for any other message for our {location.name} office.
  </p>
  <p class="fm-disclaimer" id="phi-note" role="note">
    Please do not include protected health information in your message.
  </p>

  {/*
    A plain POST. With scripting off the browser validates and then navigates
    to the thank-you page. The script below keeps the visitor on this page.
    Values stay in the request body. Nothing here is written into the URL or
    sent to analytics.
  */}
  <form
    class="fm-form"
    id="contact-form"
    method="POST"
    action="/api/contact"
    data-fallback-user={location.email?.split('@')[0]}
    data-fallback-domain={location.email?.split('@')[1]}
    data-min-submit={MIN_SUBMIT_MS}
    aria-labelledby="contact-form-title"
  >
    <input type="hidden" name="office" value={location.slug} />
    <input type="hidden" name="page" value={page} />
    <input type="hidden" name="form_loaded" id="form-loaded" value="" autocomplete="off" />

    {/*
      Honeypot. Off screen, out of tab order, and hidden from assistive tech.
      Not type=hidden: bots that skip hidden inputs still fill a text field.
      The label reads as a real field. A person never sees it. Autofill is off
      so a saved profile does not fill it and get discarded.
    */}
    <div
      class="fm-honeypot"
      aria-hidden="true"
      inert
      style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;"
    >
      <label for="vfc_hp_field">Website</label>
      <input
        id="vfc_hp_field"
        name="vfc_hp_field"
        type="text"
        tabindex="-1"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-hidden="true"
        data-1p-ignore="true"
        data-lpignore="true"
        value=""
      />
    </div>
    <script is:inline>
      (function () {
        var input = document.getElementById('form-loaded');
        if (!input) return;
        fetch('/api/contact-stamp', {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        })
          .then(function (response) {
            return response.json();
          })
          .then(function (payload) {
            if (!payload || typeof payload.stamp !== 'string' || !payload.stamp) {
              input.setAttribute('data-stamp', 'skip');
              return;
            }
            input.value = payload.stamp;
            input.setAttribute('data-received', String(Date.now()));
            input.setAttribute('data-stamp', 'ready');
          })
          .catch(function () {
            input.setAttribute('data-stamp', 'skip');
          });
      })();
    </script>

    <div class="fm-grid">
      <p class="fm-field">
        <label class="fm-label" for="name">
          Name <span class="fm-req" aria-hidden="true">*</span>
        </label>
        <input
          class="fm-input"
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="100"
          aria-describedby="name-error"
          data-error-label="Your name"
        />
        <span class="fm-error" id="name-error" data-error-for="name"></span>
      </p>

      <p class="fm-field">
        <label class="fm-label" for="email">
          Email <span class="fm-req" aria-hidden="true">*</span>
        </label>
        <input
          class="fm-input"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength="254"
          aria-describedby="email-error"
          data-error-label="Your email address"
        />
        <span class="fm-error" id="email-error" data-error-for="email"></span>
      </p>

      <p class="fm-field">
        <label class="fm-label" for="phone">Phone number</label>
        <input
          class="fm-input"
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength="40"
          aria-describedby="phone-hint phone-error"
          data-error-label="Your phone number"
        />
        <span class="fm-hint" id="phone-hint">Needed only if you would like us to call you.</span>
        <span class="fm-error" id="phone-error" data-error-for="phone"></span>
      </p>

      <p class="fm-field">
        <label class="fm-label" for="contactMethod">Preferred contact method</label>
        <select class="fm-input" id="contactMethod" name="contactMethod">
          <option value="Email">Email</option>
          <option value="Phone call">Phone call</option>
        </select>
      </p>

      <p class="fm-field fm-wide">
        <label class="fm-label" for="comments">
          How can we help? <span class="fm-req" aria-hidden="true">*</span>
        </label>
        <textarea
          class="fm-input fm-textarea"
          id="comments"
          name="comments"
          rows="5"
          required
          maxlength="4000"
          aria-describedby="comments-hint phi-note comments-error"
          data-error-label="A short message"></textarea>
        <span class="fm-hint" id="comments-hint">
          Tell us what is going on and when you would like to come in.
        </span>
        <span class="fm-error" id="comments-error" data-error-for="comments"></span>
      </p>
    </div>

    <p class="fm-required">
      Fields marked <span aria-hidden="true">*</span>
      <span class="sr">with an asterisk</span> are required.
    </p>

    {
      siteKey && (
        <div
          class="fm-turnstile"
          id="contact-turnstile"
          data-sitekey={siteKey}
          data-action="contact"
        />
      )
    }

    <button class="btn fm-submit" id="appt-request-form-button" type="submit">
      Send request
    </button>

    <div class="fm-status" id="form-status" role="status" aria-live="polite"></div>
  </form>
</div>

{
  siteKey && (
    <>
      <script is:inline>
        window.onContactTurnstile = function () {
          window.__contactTurnstileReady = true;
          document.dispatchEvent(new Event('contact-turnstile-ready'));
        };
      </script>
      <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onContactTurnstile&render=explicit"
        async
        defer></script>
    </>
  )
}

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');

  if (form && status) {
    // Suppress the browser's own bubbles now that we can render inline errors.
    // Set here rather than in the markup so no-JS visitors keep native validation.
    form.noValidate = true;

    const fields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input[required], textarea[required], input[type="email"], input[type="tel"]',
      ),
    );

    type TurnstileApi = {
      render: (container: HTMLElement, options: { sitekey: string; action: string }) => string;
      reset: (widgetId: string) => void;
    };

    let widgetId: string | null = null;

    function turnstileApi(): TurnstileApi | null {
      const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
      return api ?? null;
    }

    function mountTurnstile() {
      const container = document.querySelector<HTMLElement>('#contact-turnstile');
      const api = turnstileApi();
      const sitekey = container?.getAttribute('data-sitekey') ?? '';
      if (!container || !api || !sitekey || widgetId) return;
      widgetId = api.render(container, { sitekey, action: 'contact' });
    }

    const turnstileWindow = window as Window & { __contactTurnstileReady?: boolean };
    if (turnstileWindow.__contactTurnstileReady) mountTurnstile();
    document.addEventListener('contact-turnstile-ready', mountTurnstile);

    function errorNode(field: HTMLElement) {
      return form?.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`) ?? null;
    }

    /** Show or clear the message for one field. Returns true when valid. */
    function validate(field: HTMLInputElement | HTMLTextAreaElement) {
      const node = errorNode(field);
      const valid = field.checkValidity();

      field.setAttribute('aria-invalid', valid ? 'false' : 'true');
      if (node) node.textContent = valid ? '' : messageFor(field);
      return valid;
    }

    function messageFor(field: HTMLInputElement | HTMLTextAreaElement) {
      // `data-error-label` rather than the visible label: "How can we help?"
      // works as a question above the box but not inside a sentence.
      const label = field.dataset.errorLabel ?? 'This field';

      if (field.validity.valueMissing) return `${label} is required.`;
      if (field.validity.typeMismatch && field.type === 'email') {
        return 'Please enter a complete email address, like name@example.com.';
      }
      if (field.validity.tooLong) return `${label} is too long.`;
      return field.validationMessage || `Please check ${label.toLowerCase()}.`;
    }

    for (const field of fields) {
      // Only nag after the user has left the field once.
      field.addEventListener('blur', () => validate(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    }

    /** Stamp age is server time. This wait keeps an instant click from losing the race. */
    async function waitForStamp() {
      const input = form?.querySelector<HTMLInputElement>('input[name="form_loaded"]');
      if (!input) return;
      const started = Date.now();
      while (!input.getAttribute('data-stamp') && Date.now() - started < 4000) {
        await new Promise((resolve) => setTimeout(resolve, 50));
      }
      if (input.getAttribute('data-stamp') !== 'ready') return;
      const received = Number(input.getAttribute('data-received') ?? '');
      if (!input.value || !Number.isFinite(received)) return;
      const min = Number(form?.getAttribute('data-min-submit') ?? '2000');
      const remaining = min + 500 - (Date.now() - received);
      if (remaining > 0) await new Promise((resolve) => setTimeout(resolve, remaining));
    }

    async function refreshStamp() {
      const input = form?.querySelector<HTMLInputElement>('input[name="form_loaded"]');
      if (!input) return;
      input.value = '';
      input.removeAttribute('data-received');
      input.removeAttribute('data-stamp');
      try {
        const response = await fetch('/api/contact-stamp', {
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        });
        const payload = (await response.json().catch(() => null)) as { stamp?: string } | null;
        if (!payload || typeof payload.stamp !== 'string' || !payload.stamp) {
          input.setAttribute('data-stamp', 'skip');
          return;
        }
        input.value = payload.stamp;
        input.setAttribute('data-received', String(Date.now()));
        input.setAttribute('data-stamp', 'ready');
      } catch {
        input.setAttribute('data-stamp', 'skip');
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const results = fields.map(validate);
      if (results.includes(false)) {
        status.dataset.state = 'error';
        status.textContent = 'Please fix the highlighted fields and try again.';
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('.fm-submit');
      const originalLabel = submit?.textContent ?? '';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      status.dataset.state = '';
      status.textContent = 'Sending your message…';

      await waitForStamp();

      // The address is stored in two halves so plain-text scrapers do not
      // find a complete email address in the page source.
      const { fallbackUser, fallbackDomain } = form.dataset;
      const mailto = fallbackUser && fallbackDomain ? `${fallbackUser}@${fallbackDomain}` : '';
      const fallback = mailto
        ? `Sorry, we could not send that. Please email us at ${mailto} or give us a call.`
        : 'Sorry, we could not send that. Please give us a call and we will get you booked in.';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const payload = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;

        if (!response.ok || payload?.ok !== true) {
          const serverMessage = payload && typeof payload.error === 'string' ? payload.error : '';
          status.dataset.state = 'error';
          status.textContent = serverMessage || fallback;
          return;
        }

        status.dataset.state = 'success';
        status.textContent = 'Thank you. Your message has been sent. We will be in touch shortly.';
        form.reset();
        for (const field of fields) field.setAttribute('aria-invalid', 'false');
        void refreshStamp();
      } catch {
        status.dataset.state = 'error';
        status.textContent = fallback;
      } finally {
        if (widgetId) turnstileApi()?.reset(widgetId);
        if (submit) {
          submit.disabled = false;
          submit.textContent = originalLabel;
        }
      }
    });
  }
</script>
