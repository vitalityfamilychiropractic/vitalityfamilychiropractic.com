---
import Icon from './Icon.astro';
import Nav from './Nav.astro';
import { locations, formatStreet, telHref } from '../config/locations';
import { site } from '../config/site';
import { buildNav, type NavItem } from '../lib/nav';
import type { Location } from '../config/types';

interface Props {
  location?: Location;
  pathname?: string;
  /** Logo only, centered. Used by the chooser, the 404, and the brand privacy page. */
  landing?: boolean;
}

const { location, pathname = '/', landing = false } = Astro.props;
const homeHref = location ? `/${location.slug}/` : '/';
const others = location ? locations.filter((office) => office.slug !== location.slug) : [];
const phone = location ? telHref(location.phone) : '';

function withIds(items: NavItem[], prefix: string) {
  let n = 0;
  return items.map((item) => ({
    ...item,
    subId: item.children ? `${prefix}-sub-${n++}` : undefined,
  }));
}

const items = location && !landing ? await buildNav(location) : [];
const desktop = withIds(items, 'd');
const mobile = withIds(items, 'm');
---

<header class:list={['site-header', landing && 'is-landing']} data-header>
  <div class="hdr wrap">
    <div class="brand-lockup">
      <a class="brand" href={homeHref} aria-label={`${site.name}, home`}>
        <img class="brand-logo" src={site.logo} alt="" width="422" height="150" />
      </a>
      {
        location && !landing && others.length > 0 && (
          <details data-switcher>
            <summary>
              <span>
                {location.address.city}, {location.address.stateAbbr}
              </span>
              <Icon name="chevron" class="i chev" />
            </summary>
            <div class="switcher-menu">
              {others.map((office) => (
                <a href={`/${office.slug}/`}>
                  <span class="switcher-name">
                    {office.address.city}, {office.address.stateAbbr}
                  </span>
                  <span class="switcher-addr">{formatStreet(office)}</span>
                </a>
              ))}
            </div>
          </details>
        )
      }
    </div>
    {!landing && location && <Nav items={desktop} pathname={pathname} variant="desktop" label="Main" />}
    {
      !landing && location && (
        <div class="hdr-actions">
          <a class="btn btn-sm btn-book" href={location.bookingUrl} target="_blank" rel="noopener">
            <Icon name="calendar" />
            <span>Book Now</span>
          </a>
          <a class="btn btn-sm hdr-cta" href={`tel:${phone}`} aria-label="Schedule Your First Visit">
            <Icon name="phone" />
            <span>Schedule Your First Visit</span>
          </a>
        </div>
      )
    }
    {
      !landing && location && (
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="drawer" data-menu>
          <span class="sr">Menu</span>
          <span class="m-open"><Icon name="menu" /></span>
          <span class="m-close"><Icon name="close" /></span>
        </button>
      )
    }
  </div>
  {
    !landing && location && (
      <div class="drawer" id="drawer" data-drawer hidden>
        <Nav items={mobile} pathname={pathname} variant="mobile" label="Mobile" />
        <a class="btn btn-book" href={location.bookingUrl} target="_blank" rel="noopener">
          <Icon name="calendar" />
          <span>Book Now</span>
        </a>
        <a class="btn" href={`tel:${phone}`}>
          <Icon name="phone" />
          <span>Call to Schedule Your First Visit</span>
        </a>
        {others.length > 0 && (
          <p class="drawer-loc">
            {location.address.city}, {location.address.stateAbbr}
            {' · '}
            {others.map((office, index) => (
              <>
                {index > 0 && ' · '}
                <a href={`/${office.slug}/`}>
                  {office.address.city}, {office.address.stateAbbr}
                </a>
              </>
            ))}
          </p>
        )}
      </div>
    )
  }
</header>
{
  !landing && location && (
    <div class="m-bar" data-mbar>
      <a class="btn btn-book" href={location.bookingUrl} target="_blank" rel="noopener">
        <Icon name="calendar" />
        <span>Book Now</span>
      </a>
      <a class="btn m-call" href={`tel:${phone}`} aria-label="Call to Schedule Your First Visit">
        <Icon name="phone" />
        <span>Call to Schedule Your First Visit</span>
      </a>
      <a class="btn m-call m-msg" href={`/${location.slug}/contact/#contact-form`} aria-label="Send us a message">
        <Icon name="mail" />
        <span>Send us a message</span>
      </a>
    </div>
  )
}
