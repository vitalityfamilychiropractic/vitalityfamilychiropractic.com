---
import { locations, formatCityLine, formatStreet, telHref } from '../config/locations';
import { site } from '../config/site';
import { buildNav, isCurrent, type NavItem } from '../lib/nav';
import type { Location } from '../config/types';

interface Props {
  location?: Location;
  pathname?: string;
}

const { location, pathname = '/' } = Astro.props;
const items: NavItem[] = location ? await buildNav(location) : [];
const privacyHref = location ? `/${location.slug}/privacy/` : '/privacy/';
const year = new Date().getFullYear();

function current(href: string | undefined) {
  return isCurrent(href, pathname) ? 'page' : undefined;
}
---

<footer class="site-footer">
  <div class="wrap foot">
    <div class="foot-brand">
      <p class="foot-logo">
        <img src={site.logo} alt="Vitality Family Chiropractic" width="422" height="150" />
      </p>
      {
        location && (
          <>
            <address set:html={`${formatStreet(location)}<br>${formatCityLine(location)}`} />
            <p>
              <a href={`tel:${telHref(location.phone)}`}>{location.phone}</a>
            </p>
          </>
        )
      }
    </div>
    {
      items.length > 0 && (
        <nav aria-label="Footer">
          <ul class="foot-nav">
            {items.map((item) => (
              <li>
                {item.heading ? (
                  <span class="foot-heading">{item.label}</span>
                ) : item.href ? (
                  <a href={item.href} aria-current={current(item.href)}>
                    {item.label}
                  </a>
                ) : (
                  <span class="is-static">{item.label}</span>
                )}
                {item.children && (
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={current(child.href)}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="foot-locs">
      <p class="foot-h">Locations</p>
      <ul>
        {
          locations.map((office) => (
            <li>
              <a
                href={`/${office.slug}/`}
                aria-current={office.slug === location?.slug ? 'page' : undefined}
              >
                {office.address.city}, {office.address.stateAbbr}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="wrap foot-legal">
    <p>
      © {year} {site.name} · <a href={privacyHref}>Privacy</a>
    </p>
  </div>
</footer>
