---
import HoursTable from './HoursTable.astro';
import { site } from '../config/site';
import { locations } from '../config/locations';
import type { Location } from '../config/types';

interface Props {
  location?: Location;
}

const { location } = Astro.props;
const privacyHref = location ? `/${location.slug}/privacy/` : '/privacy/';
---

<div class="container contact">
  <div class="row py-3">
    <div class="col"><hr /></div>
  </div>
  <div class="row">
    <div class="col">
      <h3>Our Locations</h3>
    </div>
  </div>
  <div class="row">
    {
      locations.map((office) => (
        <div class="col-md-6 py-3">
          <h4>
            <i class="bi bi-geo-alt-fill text-primary" />{' '}
            <a href={`/${office.slug}/`}>{office.name}</a>
          </h4>
          <p class="px-3">
            {office.address.street}
            <br />
            {office.address.city}, {office.address.stateAbbr} {office.address.zip}
            <br />
          </p>
          <p class="px-3">
            <i class="bi bi-telephone-fill text-primary" /> {office.phone}
          </p>
          <p class="px-3">
            <i class="bi bi-envelope-fill text-primary" /> {office.email}
          </p>
          <h5 class="px-3">
            <i class="bi bi-clock-fill text-primary" /> Open Hours
          </h5>
          <div class="px-3">
            <HoursTable hours={office.hours} />
          </div>
        </div>
      ))
    }
  </div>
  <div class="row">
    {
      locations.map((office) => (
        <div class="col-md-6 py-3">
          <iframe
            src={office.mapEmbedUrl}
            title={`Map of Vitality Family Chiropractic in ${office.address.city}, ${office.address.state}`}
            style="width: 350px; height: 350px; border: 0px;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      ))
    }
  </div>
</div>
<div class="container">
  <div class="row">
    <div class="col"><hr /></div>
  </div>
  <div class="row justify-content-end">
    <div class="col-12 copyright">
      <a href={privacyHref}>Privacy Policy</a> &middot; Copyright &copy; {site.name}
    </div>
  </div>
</div>
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
