---
import Icon from './Icon.astro';
import type { Location } from '../config/types';

interface Props {
  location: Location;
  withinDays: number;
}

const { location, withinDays } = Astro.props;
const empty = `Nothing is scheduled in the next ${withinDays} days.`;
---

<div class="ev" data-events data-office={location.slug} data-days={withinDays} aria-busy="true">
  <div class="ev-stage" hidden>
    <div class="ev-track" tabindex="0" aria-label="Upcoming events"></div>
    <div class="ev-bar">
      <button type="button" class="ev-nav" data-ev-prev aria-label="Previous events">
        <Icon name="arrow" class="i ev-back" />
      </button>
      <button type="button" class="ev-nav" data-ev-next aria-label="Next events">
        <Icon name="arrow" class="i" />
      </button>
    </div>
  </div>
  <p class="ev-empty" hidden>{empty}</p>
</div>
