---
interface Props {
  name: 'phone' | 'calendar' | 'arrow' | 'chevron' | 'menu' | 'close' | 'sprig';
  class?: string;
}

const { name, class: className = 'i' } = Astro.props;
---

{
  name === 'phone' && (
    <svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
    </svg>
  )
}
{
  name === 'calendar' && (
    <svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
    </svg>
  )
}
{
  name === 'arrow' && (
    <svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )
}
{
  name === 'chevron' && (
    <svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  )
}
{
  name === 'sprig' && (
    <svg class={className} aria-hidden="true" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M32 60V22" />
      <path d="M32 40c-8-1-14-7-15-15 8 1 14 7 15 15zM32 32c8-1 14-7 15-15-8 1-14 7-15 15z" />
      <circle cx="32" cy="14" r="6" />
    </svg>
  )
}
