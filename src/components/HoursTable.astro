---
import type { HoursEntry } from '../config/types';

interface Props {
  hours: HoursEntry[];
}

const { hours } = Astro.props;
---

<table class="table hours-table">
  <caption class="visually-hidden">Open hours</caption>
  <tbody>
    {
      hours.map((entry) => {
        const slots = entry.blocks.length > 0 ? entry.blocks : [entry.note ?? ''];
        return (
          <tr>
            <th class="align-top" scope="row">
              <span class="visually-hidden">{entry.day}</span>
              <span aria-hidden="true">{entry.day.slice(0, 3)}</span>
            </th>
            <td>
              {slots.map((slot, index) => (
                <>
                  {index > 0 && <br />}
                  {slot}
                </>
              ))}
            </td>
          </tr>
        );
      })
    }
  </tbody>
</table>
