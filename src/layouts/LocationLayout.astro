---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localBusinessSchema, breadcrumbSchema } from '../lib/schema';
import { pageDescription } from '../lib/pages';
import { servicesFor } from '../lib/services';
import { teamFor } from '../lib/team';
import type { Location } from '../config/types';

interface Props {
  location: Location;
  title: string;
  description: string;
  /** Absolute path of this page, e.g. '/celebration/contact/'. */
  path: string;
  /**
   * home — office front page
   * placed — "Title in City, State | Site"
   * site — no city in the document title (the privacy policy)
   */
  titleStyle?: 'home' | 'placed' | 'site';
  /** Breadcrumb trail, emitted as BreadcrumbList structured data. */
  crumbs?: Array<{ name: string; href: string }>;
  /** Extra JSON-LD for this page. */
  schemas?: unknown[];
}

const {
  location,
  title,
  description,
  path,
  titleStyle = 'placed',
  crumbs = [],
  schemas = [],
} = Astro.props;

const members = await teamFor(location);
const services = await servicesFor(location);
const officeDescription = await pageDescription('home', location);

const allSchemas = [
  localBusinessSchema(
    location,
    members.map((member) => ({
      slug: member.id,
      name: member.data.name,
      role: member.data.role,
      schemaType: member.data.schemaType,
      credentials: member.data.credentials,
      email: member.data.email,
    })),
    services.map((service) => service.data.title),
    officeDescription,
  ),
  ...(crumbs.length > 1 ? [breadcrumbSchema(crumbs)] : []),
  ...schemas,
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  titleStyle={titleStyle}
  place={{ city: location.address.city, state: location.address.state }}
  analyticsId={location.analyticsId}
  schemas={allSchemas}
>
  <Header location={location} pathname={path} />
  {location.announcement && <p class="announce">{location.announcement}</p>}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer location={location} pathname={path} />
</BaseLayout>
