---
import '../styles/site.css';
import '../styles/extras.css';
import { site } from '../config/site';

interface Props {
  /** Page title, without the site-name suffix. */
  title: string;
  description: string;
  /** Absolute path for the canonical URL, e.g. '/celebration/pricing/'. */
  path: string;
  /**
   * home — "Vitality Family Chiropractic | Celebration, Florida"
   * placed — "Pricing in Celebration, Florida | Vitality Family Chiropractic"
   * site — "Pricing | Vitality Family Chiropractic"
   */
  titleStyle?: 'home' | 'placed' | 'site';
  place?: { city: string; state: string };
  /** Google Analytics measurement id. Falls back to the brand id. */
  analyticsId?: string;
  /** JSON-LD blocks to embed in <head>. */
  schemas?: unknown[];
  /** Set true on pages that should not be indexed. */
  noindex?: boolean;
  /** Site-relative path to the social share image. */
  ogImage?: string;
}

const {
  title,
  description,
  path,
  titleStyle = 'site',
  place,
  analyticsId = site.analyticsId,
  schemas = [],
  noindex = false,
  ogImage = site.ogImage,
} = Astro.props;

const documentTitle =
  titleStyle === 'home' && place
    ? `${site.name} | ${place.city}, ${place.state}`
    : titleStyle === 'placed' && place
      ? `${title} in ${place.city}, ${place.state} | ${site.name}`
      : title === site.name
        ? site.name
        : `${title} | ${site.name}`;

const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const usingDefaultOg = ogImage === site.ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#FAF7F1" />

    <meta property="og:title" content={documentTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {usingDefaultOg && <meta property="og:image:width" content="1200" />}
    {usingDefaultOg && <meta property="og:image:height" content="630" />}
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,50..100;1,9..144,300..700,50..100&family=Nunito+Sans:ital,opsz,wght@0,6..12,400..800;1,6..12,400&display=swap"
      rel="stylesheet"
    />

    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16x16.png" />
    <link rel="icon" href="/assets/img/favicon.ico" />
    <link rel="manifest" href="/assets/img/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      analyticsId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`} />
          <script is:inline define:vars={{ analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', analyticsId);
          </script>
        </>
      )
    }

    {
      schemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script src="/site.js" defer></script>
  </body>
</html>
