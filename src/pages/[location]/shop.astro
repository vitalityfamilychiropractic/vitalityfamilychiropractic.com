---
import { getEntry } from 'astro:content';
import ShopLayout from '../../layouts/ShopLayout.astro';
import { locations } from '../../config/locations';
import { pageDescription } from '../../lib/pages';
import { getMember } from '../../lib/team';
import { applyTokens, tokensFor } from '../../lib/tokens';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/shop/`;
const entry = await getEntry('pages', 'shop');
if (!entry) throw new Error('Missing src/content/pages/shop.md');
if (!entry.data.intro) throw new Error('src/content/pages/shop.md is missing intro');
if (!entry.data.products) throw new Error('src/content/pages/shop.md is missing products');
const lead = await getMember(location.lead);
const intro = applyTokens(entry.data.intro, tokensFor(location, lead.data));
const description = await pageDescription('shop', location);
---

<ShopLayout
  location={location}
  title={entry.data.title}
  description={description}
  path={path}
  intro={intro}
  products={entry.data.products}
/>
