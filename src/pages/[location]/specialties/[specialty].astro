---
import { getCollection, render } from 'astro:content';
import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SpecialtyGrid from '../../../components/SpecialtyGrid.astro';
import { locations } from '../../../config/locations';
import { getMember, displayName } from '../../../config/team';
import { tokensFor, applyTokens } from '../../../lib/tokens';
import { specialtyImage, specialtyLead } from '../../../lib/specialties';
import type { Location } from '../../../config/types';

/**
 * One page per (office, specialty it offers) pair — not the full cartesian
 * product. A shared Markdown file renders under every office that lists it,
 * with that office's lead, photo and booking link; a file only one office
 * lists produces a page only under that office.
 */
export async function getStaticPaths() {
  const entries = await getCollection('specialties');
  const bySlug = new Map(entries.map((entry) => [entry.id, entry]));

  return locations.flatMap((location) =>
    location.specialties.map((slug) => {
      const entry = bySlug.get(slug);
      if (!entry) {
        throw new Error(
          `Location "${location.slug}" lists specialty "${slug}", but there is no src/content/specialties/${slug}.md.`,
        );
      }
      return {
        params: { location: location.slug, specialty: slug },
        props: { location, entry },
      };
    }),
  );
}

type Entry = Awaited<ReturnType<typeof getCollection<'specialties'>>>[number];

interface Props {
  location: Location;
  entry: Entry;
}

const { location, entry } = Astro.props;
const path = `/${location.slug}/specialties/${entry.id}/`;

// The office's lead voices the page copy…
const voice = getMember(location.lead);
// …while the contact card can name someone else entirely, so a service the
// lead does not personally deliver points at the person who does.
const { member: cardMember, label: cardLabel } = specialtyLead(location, entry.id);

/*
 * Bio pages are generated from `location.team`, so someone assigned to a
 * specialty but not yet listed on the team has no page to link to. Link only
 * when the page exists — otherwise the name renders as plain text and starts
 * linking by itself the moment they are added to `team`.
 */
const cardMemberUrl = location.team.includes(cardMember.slug)
  ? `/${location.slug}/team/${cardMember.slug}/`
  : null;

// `render()` populates `entry.rendered`, which is what gives us the HTML as a
// string to run token substitution over.
await render(entry);
const html = applyTokens(entry.rendered?.html ?? '', tokensFor(location, voice));

// May be null: a newly added service can go live before its photo exists.
const image = specialtyImage(location, entry.id);
---

<LocationLayout
  location={location}
  title={entry.data.title}
  description={entry.data.summary}
  path={path}
  ogImage={image?.src}
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: entry.data.title, href: path },
  ]}
>
  <PageHeader
    eyebrow="Specialties"
    title={entry.data.title}
    standfirst={entry.data.standfirst}
    crumbs={[
      { name: 'Home', href: `/${location.slug}/` },
      { name: entry.data.title, href: path },
    ]}
  />

  <section class="section" aria-labelledby="detail-heading">
    <div class="container detail">
      <div class="detail__body">
        <h2 class="visually-hidden" id="detail-heading">
          About {entry.data.title.toLowerCase()}
        </h2>
        {/*
          Substituted after markdown processing rather than before, so tokens
          keep working inside links and emphasis.
        */}
        <div class="prose" set:html={html} />
      </div>

      <aside class="detail__aside" aria-label="At a glance">
        {
          image && (
            <img
              class="detail__image"
              src={image.src}
              width="960"
              height="960"
              decoding="async"
              alt={image.alt}
            />
          )
        }
        <div class="detail__card card">
          <p class="detail__cardLabel">{cardLabel}</p>
          <p class="detail__cardName">
            {
              cardMemberUrl ? (
                <a href={cardMemberUrl}>{displayName(cardMember)}</a>
              ) : (
                displayName(cardMember)
              )
            }
          </p>
          {
            cardMember.certifications && (
              <p class="detail__cardMeta">{cardMember.certifications}</p>
            )
          }
          <a
            class="btn btn--primary detail__cardBook"
            href={location.bookingUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            Book an Appointment
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="more-heading">
    <div class="container">
      <p class="eyebrow">Also at our {location.name} office</p>
      <h2 class="more__title" id="more-heading">Explore our other specialties</h2>
      <div class="more__grid">
        <SpecialtyGrid
          location={location}
          exclude={entry.id}
          headingId="more-heading"
        />
      </div>
    </div>
  </section>
</LocationLayout>

<style>
  .detail {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .detail__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-m);
  }

  /* Only spaced away from the photo when there is one. */
  .detail__image + .detail__card {
    margin-block-start: var(--space-m);
  }

  .detail__card {
    padding: var(--space-m);
    background: var(--vfc-blue-mist);
    box-shadow: none;
    border: 1px solid var(--border);
  }

  .detail__cardLabel {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--vfc-gray-ink);
  }

  .detail__cardName {
    margin-block-start: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 650;
  }

  .detail__cardName a {
    color: var(--ink);
    text-decoration: none;
  }

  .detail__cardName a:hover {
    color: var(--vfc-blue-ink);
    text-decoration: underline;
  }

  .detail__cardMeta {
    margin-block-start: 0.25rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .detail__cardBook {
    width: 100%;
    margin-block-start: var(--space-m);
  }

  .more__title {
    font-size: var(--step-3);
  }

  .more__grid {
    margin-block-start: var(--space-xl);
  }

  @media (min-width: 58rem) {
    .detail {
      grid-template-columns: 1fr 20rem;
      gap: var(--space-2xl);
    }

    .detail__aside {
      position: sticky;
      top: 7rem;
    }
  }
</style>
