---
import LocationLayout from '../../layouts/LocationLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PricingTable from '../../components/PricingTable.astro';
import { locations } from '../../config/locations';
import { pageDescription } from '../../lib/pages';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/pricing/`;
const IntroTag = location.pricingIntroLevel;
const description = await pageDescription('pricing', location);
---

<LocationLayout
  location={location}
  title="Pricing"
  description={description}
  path={path}
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: 'Pricing', href: path },
  ]}
>
  <PageHeader title="Pricing" />
  <div class="container-fluid">
    <div class="row">
      <div class="col p-5">
        <div class="container content">
          <div class="row">
            <div class="col">
              <IntroTag>{location.pricingIntro}</IntroTag>
              {
                location.insuranceNote && (
                  <p>
                    <strong>Insurance:</strong> {location.insuranceNote}
                  </p>
                )
              }
              <div class="alert alert-success text-center" role="alert">
                <h3 style="margin-bottom:0;">{location.pricingNotice}</h3>
              </div>
              {
                location.feesHeading && (
                  <h4>{location.feesHeading}</h4>
                )
              }
              {
                location.fees.length > 0 && (
                  <p>
                    {location.fees.map((fee, index) => (
                      <>
                        {index > 0 && <br />}
                        <strong>{fee.label}:</strong> {fee.amount}
                      </>
                    ))}
                  </p>
                )
              }
            </div>
          </div>
          <PricingTable pricing={location.pricing} />
        </div>
      </div>
    </div>
  </div>
</LocationLayout>
