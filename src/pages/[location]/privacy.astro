---
import { getEntry, render } from 'astro:content';
import LocationLayout from '../../layouts/LocationLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { locations } from '../../config/locations';
import { pageDescription } from '../../lib/pages';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/privacy/`;

const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('Missing src/content/pages/privacy.md');
const { Content } = await render(entry);
const description = await pageDescription('privacy', location);
---

<LocationLayout
  location={location}
  title={entry.data.title}
  description={description}
  path={path}
  titleStyle="site"
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: entry.data.title, href: path },
  ]}
>
  <PageHeader title={entry.data.title} />
  <div class="container-fluid">
    <div class="row my-5">
      <div class="col px-5 content">
        <Content />
      </div>
    </div>
  </div>
</LocationLayout>
