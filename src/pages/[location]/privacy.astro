---
import { getEntry, render } from 'astro:content';
import LocationLayout from '../../layouts/LocationLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { locations } from '../../config/locations';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/privacy/`;

const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('Missing src/content/pages/privacy.md');
const { Content } = await render(entry);
---

<LocationLayout
  location={location}
  title={entry.data.title}
  description={entry.data.summary}
  path={path}
  showCta={false}
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: entry.data.title, href: path },
  ]}
>
  <PageHeader
    title={entry.data.title}
    standfirst={entry.data.updated
      ? `Effective ${entry.data.updated}`
      : undefined}
    crumbs={[
      { name: 'Home', href: `/${location.slug}/` },
      { name: entry.data.title, href: path },
    ]}
  />

  <section class="section">
    <div class="container container--narrow">
      <div class="prose legal">
        <Content />
      </div>
    </div>
  </section>
</LocationLayout>

<style>
  .legal :global(h2) {
    font-size: var(--step-2);
  }

  .legal :global(h3) {
    font-size: var(--step-0);
    color: var(--vfc-gray-ink);
  }

  .legal :global(ul) {
    color: var(--ink-muted);
  }
</style>
