---
import { getEntry } from 'astro:content';
import LocationLayout from '../../layouts/LocationLayout.astro';
import Icon from '../../components/Icon.astro';
import { locations } from '../../config/locations';
import { pageDescription, privacyHtml } from '../../lib/pages';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/privacy/`;
const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('Missing src/content/pages/privacy.md');
const html = privacyHtml(entry);
const description = await pageDescription('privacy', location);
---

<LocationLayout
  location={location}
  title={entry.data.title}
  description={description}
  path={path}
  titleStyle="site"
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: entry.data.title, href: path },
  ]}
>
  <section class="tm-hero" aria-labelledby="privacy-title">
    <div class="wrap">
      <div class="tm-hero-inner reveal">
        <Icon name="sprig" class="sprig" />
        <h1 id="privacy-title">{entry.data.title}</h1>
      </div>
    </div>
  </section>
  <div class="wrap prose">
    {entry.data.updated && <p class="prose-updated">Updated {entry.data.updated}</p>}
    <Fragment set:html={html} />
  </div>
</LocationLayout>
