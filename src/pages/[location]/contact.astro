---
import LocationLayout from '../../layouts/LocationLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import HoursTable from '../../components/HoursTable.astro';
import { locations, formatAddress, telHref } from '../../config/locations';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/contact/`;
---

<LocationLayout
  location={location}
  title="Contact Us"
  description={`Get in touch with our ${location.name} office at ${formatAddress(
    location,
  )}, or call ${location.phone}.`}
  path={path}
  showCta={false}
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: 'Contact Us', href: path },
  ]}
>
  <PageHeader
    eyebrow={`${location.name} office`}
    title="Contact Us"
    standfirst="Send us a note and we will get back to you, or book straight into the calendar if you already know what you need."
    crumbs={[
      { name: 'Home', href: `/${location.slug}/` },
      { name: 'Contact Us', href: path },
    ]}
  />

  <section class="section" aria-labelledby="contact-heading">
    <div class="container contact">
      <div class="contact__form">
        <h2 class="contact__heading" id="contact-heading">
          Appointment request
        </h2>
        <p class="contact__note">
          Prefer to book yourself? Use{' '}
          <a
            href={location.bookingUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            our online scheduler<span class="visually-hidden">
              {' '}(opens in a new tab)</span
            >
          </a>{' '}
          and pick any open time.
        </p>
        <ContactForm location={location} />
      </div>

      <aside class="contact__side" aria-labelledby="details-heading">
        <div class="details card">
          <h2 class="contact__heading" id="details-heading">
            {location.name}
          </h2>

          <address class="details__address">
            <a
              class="details__map"
              href={location.mapUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              {location.address.street}
              {location.address.street2 && <>{' '}{location.address.street2}</>}<br />
              {location.address.city}, {location.address.state}
              {' '}{location.address.zip}
              <span class="visually-hidden">
                {' '}— open in Google Maps (opens in a new tab)
              </span>
            </a>
            <a class="details__line" href={`tel:${telHref(location.phone)}`}>
              {location.phone}
            </a>
            <a class="details__line" href={`mailto:${location.email}`}>
              {location.email}
            </a>
          </address>

          <HoursTable
            hours={location.hours}
            caption="Opening hours"
            showCaption
            class="details__hours"
          />

          <a
            class="btn btn--primary details__book"
            href={location.bookingUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            Book an Appointment
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="map-heading">
    <div class="container">
      <h2 class="contact__heading" id="map-heading">Find us</h2>
      <p class="contact__note">{formatAddress(location)}</p>
      <div class="map">
        <iframe
          class="map__frame"
          src={location.mapEmbedUrl}
          title={`Map showing the location of our ${location.name} office at ${formatAddress(
            location,
          )}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</LocationLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .contact__heading {
    font-size: var(--step-2);
    margin-block-end: var(--space-2xs);
  }

  .contact__note {
    margin-block-end: var(--space-l);
    color: var(--ink-muted);
  }

  .details {
    padding: var(--space-m);
    background: var(--vfc-blue-mist);
    box-shadow: none;
    border: 1px solid var(--border);
  }

  .details__address {
    font-style: normal;
    margin-block: var(--space-s) var(--space-m);
  }

  /* One step down the scale: at body size the email address is wider than the
     sidebar card and had to break mid-word to fit. */
  .details__map,
  .details__line {
    display: block;
    padding-block: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    /* Belt and braces for a longer address at a future office. */
    overflow-wrap: anywhere;
  }

  .details__map:hover,
  .details__line:hover {
    color: var(--vfc-blue-ink);
    text-decoration: underline;
  }

  .details__line {
    font-weight: 650;
    color: var(--vfc-blue-ink);
  }

  .details__book {
    width: 100%;
    margin-block-start: var(--space-m);
  }

  /*
   * A fixed aspect keeps the embed from collapsing before the iframe loads.
   *
   * No `min-height` here: combined with `aspect-ratio` it sets a *floor on the
   * width* too (18rem tall at 16:9 is 512px wide), which pushed the whole page
   * sideways on a phone. A taller ratio on small screens gives the map enough
   * height without dictating a width.
   */
  .map {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-m);
    background: var(--surface-sunk);
  }

  @media (min-width: 40rem) {
    .map {
      aspect-ratio: 16 / 9;
    }
  }

  .map__frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (min-width: 58rem) {
    .contact {
      grid-template-columns: 1fr 21rem;
      gap: var(--space-2xl);
    }
  }
</style>
