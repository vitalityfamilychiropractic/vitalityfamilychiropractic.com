---
import LocationLayout from '../../layouts/LocationLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import { locations } from '../../config/locations';
import { pageDescription } from '../../lib/pages';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/contact/`;
const description = await pageDescription('contact', location);
---

<LocationLayout
  location={location}
  title="Contact Us"
  description={description}
  path={path}
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: 'Contact Us', href: path },
  ]}
>
  <PageHeader title="Contact Us" />
  <div class="container-fluid">
    <div class="row">
      <div class="col p-5">
        <ContactForm location={location} />
      </div>
    </div>
  </div>
</LocationLayout>
