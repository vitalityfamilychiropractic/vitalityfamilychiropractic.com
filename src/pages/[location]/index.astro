---
import LocationLayout from '../../layouts/LocationLayout.astro';
import Hero from '../../components/Hero.astro';
import SpecialtyGrid from '../../components/SpecialtyGrid.astro';
import { locations } from '../../config/locations';
import { getMember, highlightsFor } from '../../config/team';
import { homeCopy } from '../../lib/home';
import { getSpecialtiesFor } from '../../lib/specialties';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/`;
const lead = getMember(location.lead);
const { intro, description } = await homeCopy(location);
const specialties = await getSpecialtiesFor(location);
const highlights = highlightsFor(lead, location.slug);
const passions = lead.passions ?? [];
---

<LocationLayout
  location={location}
  title="Home"
  description={description}
  path={path}
  titleStyle="home"
  crumbs={[{ name: location.name, href: path }]}
>
  {
    location.announcement && (
      <div class="container-fluid now-accepting">
        <div class="row">
          <div class="col-12">
            <div class="alert alert-info text-center" role="alert">
              <p class="h3 mb-0">{location.announcement}</p>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <Hero location={location} intro={intro} />
  <SpecialtyGrid location={location} specialties={specialties} />

  <div class="container-fluid why-me" style={`--why-me-image: url('${location.images.whyMe}')`}>
    <div class="row justify-content-lg-end">
      <div class="col-10 col-lg-6 card m-5 rounded-3">
        <h2 class="m-5">Why Choose Me?</h2>
        <ul class="mx-5 nav nav-underline" id="whyMeTabs" role="tablist" aria-label="Why choose me">
          <li class="nav-item" role="presentation">
            <button
              class="nav-link active"
              id="experience-tab"
              data-bs-toggle="tab"
              data-bs-target="#experience-tab-pane"
              type="button"
              role="tab"
              aria-controls="experience-tab-pane"
              aria-selected="true"
            >
              Experience
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class="nav-link"
              id="passions-tab"
              data-bs-toggle="tab"
              data-bs-target="#passions-tab-pane"
              type="button"
              role="tab"
              aria-controls="passions-tab-pane"
              aria-selected="false"
            >
              Passions
            </button>
          </li>
        </ul>
        <div class="mx-5 my-3 tab-content" id="whyMeTabsContent">
          <div
            class="tab-pane fade show active"
            id="experience-tab-pane"
            role="tabpanel"
            aria-labelledby="experience-tab"
            tabindex="0"
          >
            <ul class="lh-lg">
              {highlights.map((item) => <li set:html={item} />)}
            </ul>
          </div>
          <div
            class="tab-pane fade"
            id="passions-tab-pane"
            role="tabpanel"
            aria-labelledby="passions-tab"
            tabindex="0"
          >
            <ul class="lh-lg">
              {passions.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <div class="mx-5 my-3">
          <a class="fw-bold link-primary" href={`/${location.slug}/team/${lead.slug}/`}>
            Read More <span aria-hidden="true">&gt;</span>
            <span class="visually-hidden"> about {lead.shortName}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  {
    location.reviewsWidgetId && (
      <div class="container-fluid read-reviews">
        <div class="row justify-content-evenly">
          <div class="col-10 m-5">
            <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
            <div
              class={`elfsight-app-${location.reviewsWidgetId}`}
              data-elfsight-app-lazy
              role="region"
              aria-label="Patient reviews"
            />
          </div>
        </div>
      </div>
    )
  }
</LocationLayout>
