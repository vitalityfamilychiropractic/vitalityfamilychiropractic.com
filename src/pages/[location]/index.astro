---
import { getEntry } from 'astro:content';
import LocationLayout from '../../layouts/LocationLayout.astro';
import Blocks from '../../components/Blocks.astro';
import { locations } from '../../config/locations';
import { pageDescription } from '../../lib/pages';
import { servicesFor } from '../../lib/services';
import { getMember } from '../../lib/team';
import { tokensFor } from '../../lib/tokens';
import type { Location } from '../../config/types';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { location: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const path = `/${location.slug}/`;
const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.md');
const lead = await getMember(location.lead);
const services = await servicesFor(location);
const description = await pageDescription('home', location);
---

<LocationLayout
  location={location}
  title={entry.data.title}
  description={description}
  path={path}
  titleStyle="home"
  crumbs={[{ name: location.name, href: path }]}
>
  <Blocks
    sections={entry.data.sections}
    location={location}
    tokens={tokensFor(location, lead.data)}
    services={services}
  />
</LocationLayout>
