---
import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PracticeYears from '../../../components/PracticeYears.astro';
import { locations } from '../../../config/locations';
import { getMember, displayName } from '../../../config/team';
import { site } from '../../../config/site';
import { applyTokens, tokensFor } from '../../../lib/tokens';
import type { Location, TeamMember } from '../../../config/types';

/**
 * One page per team member per office. Someone who works at two locations gets
 * a page under each, so the phone number, booking link and surrounding nav all
 * belong to the office the visitor is browsing — from a single bio record.
 */
export function getStaticPaths() {
  return locations.flatMap((location) =>
    location.team.map((slug) => ({
      params: { location: location.slug, member: slug },
      props: { location, member: getMember(slug) },
    })),
  );
}

interface Props {
  location: Location;
  member: TeamMember;
}

const { location, member } = Astro.props;
const path = `/${location.slug}/team/${member.slug}/`;
const fullName = displayName(member);
const summary = member.summary
  ? applyTokens(member.summary, tokensFor(location, member))
  : (member.bio?.[0] ?? `${fullName} — ${member.role} at our ${location.name} office.`);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': member.schemaType,
  name: fullName,
  jobTitle: member.role,
  url: `${site.url}${path}`,
  ...(member.photo ? { image: `${site.url}${member.photo}` } : {}),
  email: member.email,
  telephone: location.phone,
  ...(member.schemaType === 'Physician' ? { medicalSpecialty: 'Chiropractic' } : {}),
  description: summary,
  worksFor: { '@id': `${site.url}/${location.slug}/` },
};
---

<LocationLayout
  location={location}
  title={fullName}
  description={summary}
  path={path}
  schemas={[personSchema]}
  crumbs={[
    { name: location.name, href: `/${location.slug}/` },
    { name: 'Team', href: `/${location.slug}/team/` },
    { name: fullName, href: path },
  ]}
>
  <PageHeader title={fullName} />
  <div class="container content team-member">
    <div class="row py-5">
      <div class="col">
        {
          member.photo && (
            <img class="img-fluid rounded" src={member.photo} alt={fullName} />
          )
        }
      </div>
      <div class="col">
        {member.certifications && <p><strong>Certifications:</strong> {member.certifications}</p>}
        {member.specialty && <p><strong>Specialty:</strong> {member.specialty}</p>}
        <p>
          <strong>Length of Work:</strong> <PracticeYears startDate={member.practiceStartDate} />
        </p>
        {member.email && <p><strong>Email:</strong> {member.email}</p>}
        <p><strong>Phone:</strong> {location.phone}</p>
        {
          member.facebook && (
            <p>
              <a href={`https://www.facebook.com/${member.facebook}`} target="_blank" rel="noopener noreferrer">
                <i class="bi bi-facebook fs-4" />
                <span class="visually-hidden">Facebook</span>
              </a>
            </p>
          )
        }
      </div>
    </div>
    {
      member.bio && member.bio.length > 0 && (
        <div class="row">
          <div class="col biography">
            <h3>Biography</h3>
            {member.bio.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      )
    }
    {
      ((member.practiceMix && member.practiceMix.length > 0) ||
        (member.priorities && member.priorities.length > 0)) && (
        <div class="row py-5">
          {member.practiceMix && member.practiceMix.length > 0 && (
            <div class="col">
              <h3>My Practice</h3>
              {member.practiceMix.map((item) => (
                <>
                  <h5>{item.label}</h5>
                  <div
                    class="progress"
                    role="progressbar"
                    aria-label={item.label}
                    aria-valuenow={item.percent}
                    aria-valuemin={0}
                    aria-valuemax={100}
                  >
                    <div class="progress-bar" style={`width: ${item.percent}%;`}>
                      {item.percent}%
                    </div>
                  </div>
                  <br />
                </>
              ))}
            </div>
          )}
          {member.priorities && member.priorities.length > 0 && (
            <div class="col">
              <h3>What's Important to Me as a Doctor</h3>
              <ul class="lh-lg">
                {member.priorities.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}
        </div>
      )
    }
    {
      member.community && member.community.length > 0 && (
        <div class="row">
          <div class="col">
            <h3>In the Office and In the Community</h3>
            {member.community.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      )
    }
  </div>
</LocationLayout>
