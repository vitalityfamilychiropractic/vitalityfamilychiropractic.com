---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { locations } from '../config/locations';
import { organizationSchema } from '../lib/schema';
---

<BaseLayout
  title={site.name}
  description={site.description}
  path="/"
  noindex
  schemas={[organizationSchema(locations)]}
>
  <header>
    <Header landing />
  </header>
  <main id="main" tabindex="-1">
    <h1 class="visually-hidden">Choose your Vitality Family Chiropractic office</h1>
    <div class="container-fluid landing-page">
      <div class="row">
        {
          locations.map((office) => (
            <div
              class="col-md d-flex align-items-center justify-content-center text-center landing-office"
              style={`--landing-image: url('${office.images.landing}')`}
            >
              <a class="btn btn-primary btn-lg" href={`/${office.slug}/`}>
                {office.address.city}, {office.address.stateAbbr}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <footer>
    <Footer />
  </footer>
</BaseLayout>
