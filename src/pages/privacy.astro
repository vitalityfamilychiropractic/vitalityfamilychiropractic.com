---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';

/**
 * Brand-level copy of the policy, linked from the location chooser's footer.
 * Each office also serves it under its own path with that office's navigation.
 */
const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('Missing src/content/pages/privacy.md');
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  path="/privacy/"
>
  <header class="masthead">
    <div class="container">
      <a class="masthead__home" href="/">
        <img
          class="masthead__logo"
          src={site.logo}
          width="421"
          height="150"
          alt={site.name}
        />
      </a>
    </div>
  </header>

  <main id="main">
    <PageHeader
      title={entry.data.title}
      standfirst={entry.data.updated
        ? `Effective ${entry.data.updated}`
        : undefined}
      crumbs={[
        { name: 'Home', href: '/' },
        { name: entry.data.title, href: '/privacy/' },
      ]}
    />

    <section class="section">
      <div class="container container--narrow">
        <div class="prose legal">
          <Content />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .masthead {
    padding-block: var(--space-m);
    border-block-end: 1px solid var(--border);
  }

  .masthead__home {
    display: inline-block;
  }

  .masthead__logo {
    width: auto;
    height: var(--logo-height);
  }

  .legal :global(h2) {
    font-size: var(--step-2);
  }

  .legal :global(h3) {
    font-size: var(--step-0);
    color: var(--vfc-gray-ink);
  }

  .legal :global(ul) {
    color: var(--ink-muted);
  }
</style>
