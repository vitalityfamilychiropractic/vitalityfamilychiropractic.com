---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('Missing src/content/pages/privacy.md');
const { Content } = await render(entry);
const description = entry.data.brandSummary ?? entry.data.summary;
if (description.includes('{{')) {
  throw new Error(
    'The brand privacy page description still has a content token. Set brandSummary in src/content/pages/privacy.md.',
  );
}
---

<BaseLayout title={entry.data.title} description={description} path="/privacy/">
  <Header landing />
  <main id="main" tabindex="-1">
    <section class="tm-hero" aria-labelledby="privacy-title">
      <div class="wrap">
        <div class="tm-hero-inner reveal">
          <Icon name="sprig" class="sprig" />
          <h1 id="privacy-title">{entry.data.title}</h1>
        </div>
      </div>
    </section>
    <div class="wrap prose">
      {entry.data.updated && <p class="prose-updated">Updated {entry.data.updated}</p>}
      <Content />
    </div>
  </main>
  <Footer />
</BaseLayout>
